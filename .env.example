# GovAssist AI Configuration

# Server Setup
PORT=8000
HOST=0.0.0.0
JWT_SECRET=super_secret_jwt_key_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database URL (Defaults to SQLite for local standalone ease-of-use, can be swapped to PostgreSQL)
DATABASE_URL=sqlite:///./govassist.db
# DATABASE_URL=postgresql://user:password@localhost:5432/govassist

# AI & LLM Settings
# If OPENAI_API_KEY is left empty, the application will automatically run in fallback/local mock mode
# and provide local FAISS-grounded responses without calling external APIs.
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini

# Sentence Transformers Local Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage Folders (Absolute or relative paths)
PDF_FOLDER=backend/documents
DATASET_FOLDER=backend/datasets
VECTOR_DB_PATH=backend/vector_db
